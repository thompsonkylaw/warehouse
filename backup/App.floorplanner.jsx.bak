import React, { useState, useEffect, useRef } from 'react';
import { Plus, Trash2, Maximize, CheckCircle, XCircle, Grid, X } from 'lucide-react';

// --- Constants & Configuration ---
const WAREHOUSE_WIDTH_FT = 100;
const WAREHOUSE_HEIGHT_FT = 100;
const PIXELS_PER_FT = 8; // 800x800 canvas
const GRID_SIZE_PX = 20; // Snap to 20px (2.5ft) grid

const WAREHOUSE_WIDTH_PX = WAREHOUSE_WIDTH_FT * PIXELS_PER_FT;
const WAREHOUSE_HEIGHT_PX = WAREHOUSE_HEIGHT_FT * PIXELS_PER_FT;

const STATUS_COLORS = {
  vacant: 'bg-green-100 border-green-500 text-green-800',
  occupied: 'bg-red-100 border-red-500 text-red-800',
  maintenance: 'bg-yellow-100 border-yellow-500 text-yellow-800',
};

export default function App() {
  // --- State ---
  const [units, setUnits] = useState([
    { id: '1', name: 'A-01', x: 20, y: 20, w: 80, h: 100, status: 'vacant' },
    { id: '2', name: 'A-02', x: 120, y: 20, w: 80, h: 100, status: 'occupied' },
    { id: '3', name: 'B-01', x: 20, y: 140, w: 120, h: 80, status: 'vacant' },
  ]);
  const [selectedId, setSelectedId] = useState(null);
  const [editingUnitId, setEditingUnitId] = useState(null); // State for the double-click edit modal
  const [isDragging, setIsDragging] = useState(false);
  const [dragOffset, setDragOffset] = useState({ x: 0, y: 0 });
  const [snapToGrid, setSnapToGrid] = useState(true);
  const [autoCollision, setAutoCollision] = useState(true);

  const containerRef = useRef(null);

  // --- Helpers ---
  const selectedUnit = units.find((u) => u.id === selectedId);
  const editingUnit = units.find((u) => u.id === editingUnitId);

  // Checks if a proposed bounding box overlaps with any other unit
  const checkCollision = (x, y, w, h, excludeId) => {
    return units.some((u) => {
      if (u.id === excludeId) return false;
      return (
        x < u.x + u.w &&
        x + w > u.x &&
        y < u.y + u.h &&
        y + h > u.y
      );
    });
  };

  // --- Handlers ---
  const addUnit = () => {
    const newId = Math.random().toString(36).substr(2, 9);
    setUnits([
      ...units,
      {
        id: newId,
        name: `U-${units.length + 1}`,
        x: 0,
        y: 0,
        w: 80, // 10x10 ft
        h: 80,
        status: 'vacant',
      },
    ]);
    setSelectedId(newId);
  };

  const deleteSelected = () => {
    if (!selectedId) return;
    setUnits(units.filter((u) => u.id !== selectedId));
    setSelectedId(null);
    setEditingUnitId(null);
  };

  const updateSelectedUnit = (updates) => {
    if (!selectedId) return;
    setUnits(units.map((u) => (u.id === selectedId ? { ...u, ...updates } : u)));
  };

  const updateEditingUnit = (updates) => {
    if (!editingUnitId) return;
    setUnits(units.map((u) => (u.id === editingUnitId ? { ...u, ...updates } : u)));
  };

  // --- Drag and Drop Logic ---
  const handlePointerDown = (e, id) => {
    e.stopPropagation();
    setSelectedId(id);
    setIsDragging(true);

    const unit = units.find((u) => u.id === id);
    // Calculate where the user clicked relative to the unit's top-left corner
    const containerRect = containerRef.current.getBoundingClientRect();
    const offsetX = e.clientX - containerRect.left - unit.x;
    const offsetY = e.clientY - containerRect.top - unit.y;
    
    setDragOffset({ x: offsetX, y: offsetY });
  };

  const handleDoubleClick = (e, id) => {
    e.stopPropagation();
    setSelectedId(id); // Also select it
    setEditingUnitId(id); // Open the edit modal
  };

  useEffect(() => {
    const handlePointerMove = (e) => {
      if (!isDragging || !selectedId || !containerRef.current) return;

      const containerRect = containerRef.current.getBoundingClientRect();
      let newX = e.clientX - containerRect.left - dragOffset.x;
      let newY = e.clientY - containerRect.top - dragOffset.y;

      const unit = units.find((u) => u.id === selectedId);

      // Boundaries
      if (newX < 0) newX = 0;
      if (newY < 0) newY = 0;
      if (newX + unit.w > WAREHOUSE_WIDTH_PX) newX = WAREHOUSE_WIDTH_PX - unit.w;
      if (newY + unit.h > WAREHOUSE_HEIGHT_PX) newY = WAREHOUSE_HEIGHT_PX - unit.h;

      // Snap to Grid
      if (snapToGrid) {
        newX = Math.round(newX / GRID_SIZE_PX) * GRID_SIZE_PX;
        newY = Math.round(newY / GRID_SIZE_PX) * GRID_SIZE_PX;
      }

      // Auto-Collision Detection (with edge sliding)
      if (autoCollision) {
        if (checkCollision(newX, newY, unit.w, unit.h, selectedId)) {
          const collidesX = checkCollision(newX, unit.y, unit.w, unit.h, selectedId);
          const collidesY = checkCollision(unit.x, newY, unit.w, unit.h, selectedId);
          
          if (!collidesX && newX !== unit.x) {
            newY = unit.y; // Block Y movement, slide along X
          } else if (!collidesY && newY !== unit.y) {
            newX = unit.x; // Block X movement, slide along Y
          } else {
            return; // Block movement completely if boxed in
          }
        }
      }

      updateSelectedUnit({ x: newX, y: newY });
    };

    const handlePointerUp = () => {
      if (isDragging) {
        setIsDragging(false);
      }
    };

    if (isDragging) {
      window.addEventListener('pointermove', handlePointerMove);
      window.addEventListener('pointerup', handlePointerUp);
    }

    return () => {
      window.removeEventListener('pointermove', handlePointerMove);
      window.removeEventListener('pointerup', handlePointerUp);
    };
  }, [isDragging, selectedId, dragOffset, units, snapToGrid, autoCollision]);

  // --- Renderers ---
  const renderSidebar = () => (
    <div className="w-64 bg-white border-r border-gray-200 flex flex-col h-full shadow-lg z-10 relative">
      <div className="p-6 border-b border-gray-200">
        <h1 className="text-xl font-bold text-gray-800 mb-1">Floor Planner</h1>
        <p className="text-sm text-gray-500">10,000 sq ft Facility</p>
      </div>

      <div className="p-4 border-b border-gray-200 space-y-3">
        <button
          onClick={addUnit}
          className="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 px-4 rounded-lg flex items-center justify-center transition-colors"
        >
          <Plus size={18} className="mr-2" />
          Add Mini Warehouse
        </button>
        
        <label className="flex items-center space-x-2 text-sm text-gray-700 cursor-pointer p-2 hover:bg-gray-50 rounded">
          <input 
            type="checkbox" 
            checked={snapToGrid} 
            onChange={(e) => setSnapToGrid(e.target.checked)}
            className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
          />
          <Grid size={16} />
          <span>Snap to Grid</span>
        </label>
        
        <label className="flex items-center space-x-2 text-sm text-gray-700 cursor-pointer p-2 hover:bg-gray-50 rounded">
          <input 
            type="checkbox" 
            checked={autoCollision} 
            onChange={(e) => setAutoCollision(e.target.checked)}
            className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
          />
          <XCircle size={16} />
          <span>Prevent Overlap</span>
        </label>
      </div>

      <div className="flex-1 overflow-y-auto p-4">
        {selectedUnit ? (
          <div className="space-y-5">
            <div>
              <h3 className="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-3">
                Selected Unit Details
              </h3>
              
              <div className="space-y-4">
                <div>
                  <label className="block text-xs text-gray-500 mb-1">Unit Name</label>
                  <input
                    type="text"
                    value={selectedUnit.name}
                    onChange={(e) => updateSelectedUnit({ name: e.target.value })}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                  />
                </div>

                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block text-xs text-gray-500 mb-1">Width (ft)</label>
                    <input
                      type="number"
                      value={selectedUnit.w / PIXELS_PER_FT}
                      onChange={(e) => {
                        const newW = Number(e.target.value) * PIXELS_PER_FT;
                        if (autoCollision && checkCollision(selectedUnit.x, selectedUnit.y, newW, selectedUnit.h, selectedId)) return;
                        updateSelectedUnit({ w: newW });
                      }}
                      className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                    />
                  </div>
                  <div>
                    <label className="block text-xs text-gray-500 mb-1">Depth (ft)</label>
                    <input
                      type="number"
                      value={selectedUnit.h / PIXELS_PER_FT}
                      onChange={(e) => {
                        const newH = Number(e.target.value) * PIXELS_PER_FT;
                        if (autoCollision && checkCollision(selectedUnit.x, selectedUnit.y, selectedUnit.w, newH, selectedId)) return;
                        updateSelectedUnit({ h: newH });
                      }}
                      className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-xs text-gray-500 mb-1">Status</label>
                  <select
                    value={selectedUnit.status}
                    onChange={(e) => updateSelectedUnit({ status: e.target.value })}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white"
                  >
                    <option value="vacant">Vacant</option>
                    <option value="occupied">Occupied</option>
                    <option value="maintenance">Maintenance</option>
                  </select>
                </div>

                <div className="pt-4 border-t border-gray-200">
                   <div className="text-sm text-gray-600 mb-4 flex justify-between">
                     <span>Calculated Area:</span>
                     <span className="font-semibold text-gray-900">
                        {((selectedUnit.w / PIXELS_PER_FT) * (selectedUnit.h / PIXELS_PER_FT)).toFixed(0)} sq ft
                     </span>
                   </div>
                  <button
                    onClick={deleteSelected}
                    className="w-full bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 font-medium py-2 px-4 rounded-md flex items-center justify-center transition-colors text-sm"
                  >
                    <Trash2 size={16} className="mr-2" />
                    Delete Unit
                  </button>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <div className="text-center py-10 text-gray-500 flex flex-col items-center">
            <Maximize size={32} className="mb-3 text-gray-300" />
            <p className="text-sm">Select a unit on the map to view and edit its details.</p>
          </div>
        )}
      </div>
      
      {/* Stats footer */}
      <div className="p-4 bg-gray-50 border-t border-gray-200 text-xs text-gray-600 space-y-1">
        <div className="flex justify-between">
          <span>Total Units:</span>
          <span className="font-semibold">{units.length}</span>
        </div>
        <div className="flex justify-between">
          <span>Total Allocated Area:</span>
          <span className="font-semibold">
            {units.reduce((acc, u) => acc + (u.w / PIXELS_PER_FT) * (u.h / PIXELS_PER_FT), 0).toFixed(0)} sq ft
          </span>
        </div>
      </div>
    </div>
  );

  return (
    <div className="flex h-screen bg-gray-100 font-sans overflow-hidden text-gray-800">
      {renderSidebar()}

      {/* Main Canvas Area */}
      <div 
        className="flex-1 overflow-auto p-8 relative"
        onClick={() => setSelectedId(null)} // Deselect when clicking empty space
      >
        <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-8 w-max mx-auto">
          <div className="mb-4 flex items-center justify-between">
            <h2 className="text-lg font-semibold text-gray-700">Warehouse Map (100' x 100')</h2>
            <div className="flex items-center space-x-4 text-xs">
              <span className="flex items-center"><span className="w-3 h-3 rounded-full bg-green-400 mr-1"></span> Vacant</span>
              <span className="flex items-center"><span className="w-3 h-3 rounded-full bg-red-400 mr-1"></span> Occupied</span>
              <span className="flex items-center"><span className="w-3 h-3 rounded-full bg-yellow-400 mr-1"></span> Maintenance</span>
            </div>
          </div>

          {/* The Actual Floor Plan Board */}
          <div
            ref={containerRef}
            className="relative bg-white border-2 border-gray-300 shadow-inner overflow-hidden"
            style={{
              width: `${WAREHOUSE_WIDTH_PX}px`,
              height: `${WAREHOUSE_HEIGHT_PX}px`,
              backgroundImage: `
                linear-gradient(to right, #f1f5f9 1px, transparent 1px),
                linear-gradient(to bottom, #f1f5f9 1px, transparent 1px)
              `,
              backgroundSize: `${GRID_SIZE_PX}px ${GRID_SIZE_PX}px`,
              touchAction: 'none' // Prevent mobile scrolling during drag
            }}
          >
            {units.map((unit) => {
              const isSelected = selectedId === unit.id;
              const colorClasses = STATUS_COLORS[unit.status] || STATUS_COLORS.vacant;

              return (
                <div
                  key={unit.id}
                  onPointerDown={(e) => handlePointerDown(e, unit.id)}
                  onDoubleClick={(e) => handleDoubleClick(e, unit.id)}
                  className={`absolute border-2 flex flex-col items-center justify-center cursor-move transition-shadow select-none
                    ${colorClasses}
                    ${isSelected ? 'ring-4 ring-blue-400 z-50 shadow-xl opacity-90' : 'hover:ring-2 hover:ring-blue-200 shadow-md opacity-80 z-10'}
                  `}
                  style={{
                    left: `${unit.x}px`,
                    top: `${unit.y}px`,
                    width: `${unit.w}px`,
                    height: `${unit.h}px`,
                  }}
                >
                  <span className="font-bold text-sm pointer-events-none">{unit.name}</span>
                  <span className="text-xs opacity-75 pointer-events-none">
                    {unit.w / PIXELS_PER_FT}' x {unit.h / PIXELS_PER_FT}'
                  </span>
                  
                  {/* Status Icon */}
                  <div className="absolute top-1 right-1 pointer-events-none">
                    {unit.status === 'vacant' && <CheckCircle size={12} className="text-green-600" />}
                    {unit.status === 'occupied' && <XCircle size={12} className="text-red-600" />}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {/* Double Click Edit Modal */}
      {editingUnit && (
        <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden animate-in fade-in zoom-in duration-200">
            <div className="px-5 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
              <h3 className="text-lg font-bold text-gray-800">Edit Unit: {editingUnit.name}</h3>
              <button onClick={() => setEditingUnitId(null)} className="text-gray-400 hover:text-gray-700 transition-colors">
                <X size={20} />
              </button>
            </div>
            
            <div className="p-5 space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Unit Name</label>
                <input
                  type="text"
                  value={editingUnit.name}
                  onChange={(e) => updateEditingUnit({ name: e.target.value })}
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                  autoFocus
                />
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Width (ft)</label>
                  <input
                    type="number"
                    value={editingUnit.w / PIXELS_PER_FT}
                    onChange={(e) => {
                      const newW = Number(e.target.value) * PIXELS_PER_FT;
                      if (autoCollision && checkCollision(editingUnit.x, editingUnit.y, newW, editingUnit.h, editingUnit.id)) return;
                      updateEditingUnit({ w: newW });
                    }}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Depth (ft)</label>
                  <input
                    type="number"
                    value={editingUnit.h / PIXELS_PER_FT}
                    onChange={(e) => {
                      const newH = Number(e.target.value) * PIXELS_PER_FT;
                      if (autoCollision && checkCollision(editingUnit.x, editingUnit.y, editingUnit.w, newH, editingUnit.id)) return;
                      updateEditingUnit({ h: newH });
                    }}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                  />
                </div>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Status</label>
                <select
                  value={editingUnit.status}
                  onChange={(e) => updateEditingUnit({ status: e.target.value })}
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm bg-white"
                >
                  <option value="vacant">Vacant</option>
                  <option value="occupied">Occupied</option>
                  <option value="maintenance">Maintenance</option>
                </select>
              </div>
            </div>

            <div className="px-5 py-4 border-t border-gray-100 flex justify-end">
              <button 
                onClick={() => setEditingUnitId(null)} 
                className="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg font-medium transition-colors text-sm"
              >
                Done
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}